# Railway supplies PORT automatically
PORT=3000
# In Railway, attach PostgreSQL and use the DATABASE_URL variable provided by Railway
DATABASE_URL=postgresql://user:password@localhost:5432/sakurayama
# Generate a long random secret; configure the same value in the Roblox server script
GAME_API_KEY=replace-with-a-long-random-secret
# Optional: allow local development only. Do not use * in production.
ALLOWED_ORIGIN=
